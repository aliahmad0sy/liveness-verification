# Copy to .env.local for `vercel dev`. In production, set these via the
# Vercel dashboard (Project → Settings → Environment Variables).

# Auto-injected by Vercel when you connect a Blob store; only needed locally.
# Get it from the Vercel dashboard → Storage → Blob → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# Comma-separated list of origins allowed to upload. Leave empty to allow all
# (use only for local dev). Example: https://yoursite.com,https://www.yoursite.com
ALLOWED_ORIGINS=

# Cap per-upload bytes. Default 100 MB.
MAX_UPLOAD_BYTES=104857600
