# Copy to .env.local for `vercel dev`. In production, set these via the
# Vercel dashboard (Project → Settings → Environment Variables).

# Telegram Bot API credentials. Create a bot via @BotFather to get the token,
# then start a chat with the bot and read /api/get-chat-id (or use @userinfobot)
# to get your chat id. The bot sends every verification video to this chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated list of origins allowed to upload. Leave empty to allow all
# (use only for local dev). Example: https://yoursite.com,https://www.yoursite.com
ALLOWED_ORIGINS=
