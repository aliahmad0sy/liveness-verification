generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  MERCHANT
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum KYCStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  EXCHANGE
  CARD_FUNDING
  CARD_PAYMENT
  MASS_PAYOUT
  FEE
  COMMISSION
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum CurrencyType {
  FIAT
  CRYPTO
  EBANK
}

enum CardStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?    @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             UserRole   @default(USER)
  kycStatus        KYCStatus  @default(NONE)
  isActive         Boolean    @default(true)
  isEmailVerified  Boolean    @default(false)
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  referralCode     String?    @unique
  referredBy       String?
  avatarUrl        String?
  country          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  wallets          Wallet[]
  cards            Card[]
  kycDocuments     KYCDocument[]
  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
  merchantProfile  MerchantProfile?
  agentProfile     AgentProfile?
  sessions         Session[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Currency {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  nameAr      String
  symbol      String
  type        CurrencyType
  decimals    Int          @default(2)
  isActive    Boolean      @default(true)
  logoUrl     String?
  network     String?
  contractAddress String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  wallets     Wallet[]
  ratesFrom   ExchangeRate[] @relation("RateFrom")
  ratesTo     ExchangeRate[] @relation("RateTo")

  @@index([code])
  @@index([type])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrencyId String
  toCurrencyId   String
  rate         Decimal  @db.Decimal(24, 8)
  buyRate      Decimal? @db.Decimal(24, 8)
  sellRate     Decimal? @db.Decimal(24, 8)
  fee          Decimal  @default(0) @db.Decimal(5, 4)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  fromCurrency Currency @relation("RateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("RateTo", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId])
  @@index([fromCurrencyId])
  @@index([toCurrencyId])
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String
  currencyId   String
  balance      Decimal  @default(0) @db.Decimal(24, 8)
  lockedBalance Decimal @default(0) @db.Decimal(24, 8)
  depositAddress String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     Currency @relation(fields: [currencyId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([userId, currencyId])
  @@index([userId])
  @@index([currencyId])
}

model LedgerEntry {
  id            String      @id @default(cuid())
  walletId      String
  transactionId String?
  amount        Decimal     @db.Decimal(24, 8)
  balanceBefore Decimal     @db.Decimal(24, 8)
  balanceAfter  Decimal     @db.Decimal(24, 8)
  type          String
  description   String?
  createdAt     DateTime    @default(now())

  wallet        Wallet      @relation(fields: [walletId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([walletId])
  @@index([transactionId])
}

model Transaction {
  id              String            @id @default(cuid())
  reference       String            @unique @default(cuid())
  senderId        String?
  receiverId      String?
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  fromCurrencyCode String
  toCurrencyCode   String?
  fromAmount      Decimal           @db.Decimal(24, 8)
  toAmount        Decimal?          @db.Decimal(24, 8)
  fee             Decimal           @default(0) @db.Decimal(24, 8)
  exchangeRate    Decimal?          @db.Decimal(24, 8)
  description     String?
  metadata        Json?
  externalRef     String?
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sender          User?             @relation("SentTransactions", fields: [senderId], references: [id])
  receiver        User?             @relation("ReceivedTransactions", fields: [receiverId], references: [id])
  ledgerEntries   LedgerEntry[]
  massPayoutItems MassPayoutItem[]

  @@index([senderId])
  @@index([receiverId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model Card {
  id             String     @id @default(cuid())
  userId         String
  cardNumber     String     @unique
  maskedNumber   String
  cardHolder     String
  expiryMonth    Int
  expiryYear     Int
  cvv            String
  balance        Decimal    @default(0) @db.Decimal(12, 2)
  spendingLimit  Decimal?   @db.Decimal(12, 2)
  status         CardStatus @default(ACTIVE)
  is3DSEnabled   Boolean    @default(true)
  network        String     @default("VISA")
  issuanceFee    Decimal    @default(5) @db.Decimal(6, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MassPayout {
  id          String   @id @default(cuid())
  userId      String
  name        String
  totalAmount Decimal  @db.Decimal(24, 8)
  currency    String
  itemCount   Int
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       MassPayoutItem[]

  @@index([userId])
}

model MassPayoutItem {
  id            String      @id @default(cuid())
  massPayoutId  String
  transactionId String?
  recipient     String
  amount        Decimal     @db.Decimal(24, 8)
  currency      String
  description   String?
  status        String      @default("PENDING")
  errorMessage  String?

  massPayout    MassPayout  @relation(fields: [massPayoutId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([massPayoutId])
}

model KYCDocument {
  id          String    @id @default(cuid())
  userId      String
  type        String
  fileUrl     String
  status      KYCStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model MerchantProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  businessName  String
  businessType  String?
  website       String?
  apiKey        String   @unique @default(cuid())
  apiSecret     String
  webhookUrl    String?
  isApproved    Boolean  @default(false)
  monthlyVolume Decimal  @default(0) @db.Decimal(24, 8)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKey])
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  commissionRate  Decimal  @default(0.01) @db.Decimal(5, 4)
  totalEarned     Decimal  @default(0) @db.Decimal(24, 8)
  pendingEarnings Decimal  @default(0) @db.Decimal(24, 8)
  clientCount     Int      @default(0)
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  titleAr   String?
  body      String
  bodyAr    String?
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
